    - target: {fileID: 5912584211440286702, guid: 7cc92fc86676e914d87ddb821614609c, type: 3}
      propertyPath: m_text
      value: "\xC7\u0131\u011F ak\u0131\u015F hatt\u0131ndan tamamen ka\xE7acak vaktiniz
        kalmad\u0131ysa, en yak\u0131ndaki b\xFCy\xFCk ve sabit kayay\u0131 siper
        olarak kullan\u0131n. \xC7\u0131\u011F\u0131n geli\u015F y\xF6n\xFCn\xFCn
        tam tersinde kalan kaya duvar\u0131na g\xF6vdenizi iyice yaslay\u0131n.\n\nEn
        kritik hamle: Ellerinizi ve kollar\u0131n\u0131z\u0131 kullanarak y\xFCz\xFCn\xFCz\xFC,
        a\u011Fz\u0131n\u0131z\u0131 ve burnunuzu s\u0131k\u0131ca kapat\u0131n!
        Bu pozisyon, kar k\xFCtlesinin alt\u0131nda kald\u0131\u011F\u0131n\u0131zda
        y\xFCz\xFCn\xFCz\xFCn \xF6n\xFCnde nefes alabilece\u011Finiz hayati bir hava
        bo\u015Flu\u011Fu (air pocket) olu\u015Fturur ve solunum yollar\u0131n\u0131z\u0131n
        karla dolmas\u0131n\u0131 engeller. \xC7\u0131\u011F tamamen durana kadar
        y\xFCz\xFCn\xFCz\xFC kapatmay\u0131 asla b\u0131rakmay\u0131n!"
      objectReference: {fileID: 0}
    - target: {fileID: 7362987681662711278, guid: 7cc92fc86676e914d87ddb821614609c, type: 3}
      propertyPath: m_AnchorMax.y
